---
import Head from "./Head.astro";
import Header from "../components/Header.astro";
const { frontmatter } = Astro.props;

function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const baseURL = "https://tomeverson.me"
const canonicalURL = `${baseURL}${Astro.url.pathname}`
---

<html lang="en">
  <Head
    title={frontmatter.title}
    description={frontmatter.description ?? frontmatter.title}
    ogImage={frontmatter.image ?? "/og.png"}
    ogType="article"
    canonicalURL={canonicalURL}
  />
  <body class="font-family-roboto-mono bg-page text-coffee">
    <Header />

    <main class="w-10/12 m-auto xl:w-1/2 xl:max-w-3xl py-8">
      <!-- Back to blog link -->
      <nav class="mb-8">
        <a
          href="/#blog"
          class="text-sm text-cappuccino-dark hover:text-coffee transition-colors inline-flex items-center"
        >
          ← Back to Home
        </a>
      </nav>

      <!-- Blog header -->
      <header class="mb-8 pb-6 border-b border-cappuccino-light">
        <h1
          class="text-2xl md:text-3xl font-bold text-heading mb-3 leading-tight"
        >
          {frontmatter.title}
        </h1>
        <time datetime={frontmatter.date} class="text-sm text-cappuccino">
          {formatDate(frontmatter.date)}
        </time>
      </header>

      <!-- Blog content -->
      <article
        class="prose prose-sm md:prose-base max-w-none prose-stone
        prose-img:max-w-full prose-img:max-h-120 prose-img:mx-auto prose-img:block
        prose-img:object-contain prose-img:rounded-lg prose-img:shadow-sm"
      >
        <slot />
      </article>
    </main>
  </body>
</html>
