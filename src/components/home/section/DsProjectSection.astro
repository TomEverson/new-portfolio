---
const projects = [
  {
    name: "Discount Rate Optimization",
    link: "https://github.com/TomEverson/DS-Portfolio/blob/main/discount_optimization/discount_optimization.ipynb",
    description:
      "Built a machine learning model using XGBoost to analyze and optimize discount rates from Amazon. The model, trained on historical sales data, identifies optimal discount levels to maximize revenue. The strategy was validated with an A/B test.",
    tech: [
      "XGBoost",
      "Numpy",
      "Pandas",
      "EDA",
      "Seaborn",
      "Cross-Validation",
      "A/B Testing",
    ],
    type: "Optimization",
  },
  {
    name: "Coffee Sales Prediction",
    link: "https://github.com/TomEverson/DS-Portfolio/blob/main/coffe_sales_prediction/coffee_sales_prediction.ipynb",
    description:
      "Built a machine learning model using XGBoost to predict the sales of the coffee. I also performed exploratory data analysis (EDA) on the data to understand key trends and relationships",
    tech: ["XGBoost", "Numpy", "Pandas", "EDA", "Cross-Validation", "Seaborn"],
    type: "Prediction",
  },
];
---

<div class="flex flex-col my-12" id="projects">
  <div class="typing-container w-fit">
    <h1
      id="projects"
      class="text-3xl md:text-4xl font-bold mb-8 typing-line typing-line-1 w-fit"
    >
      📊DS Projects
    </h1>
  </div>
  <div class="border-b pb-8 flex gap-2 flex-col">
    {
      projects.map((project) => (
        <a
          class="group hover:cursor-pointer border border-cappuccino-light rounded-lg p-4 hover:border-cappuccino hover:shadow-md transition-all duration-300"
          href={project.link}
        >
          <div class="flex flex-col">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-lg font-bold text-coffee group-hover:text-cappuccino-dark transition-colors">
                {project.name}
              </h3>
              <span class="text-xs font-medium px-2 py-1 bg-cream text-cappuccino-dark rounded-full ml-2 flex-shrink-0">
                {project.type}
              </span>
            </div>

            <p class="text-sm text-body mb-3 leading-relaxed">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-1">
              {project.tech.map((technology, index) => (
                <span class="text-xs px-2 py-1 bg-cream text-coffee rounded border border-cappuccino-light">
                  {technology}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>
