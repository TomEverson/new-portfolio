---
type BlogType = {
  frontmatter: {
    title: string;
    date: string;
  };
  url: string;
};

const blogs: BlogType[] = Object.values(
  import.meta.glob("/src/pages/blogs/**/*.md", { eager: true })
);

// Function to format date
function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const processUrl = (url: string) => url.replace(/^\/blogs\//, "");
---

<div class="flex flex-col my-12" id="blog">
  <div class="typing-container w-fit">
    <h1
      class="text-3xl md:text-4xl font-bold mb-8 typing-line typing-line-1 w-fit"
    >
      📝 Blog Posts
    </h1>
  </div>
  <div class="border-b pb-8 flex gap-2 flex-col">
    {
      blogs.map((blog) => (
        <a
          href={`/blogs/${processUrl(blog.url)}`}
          class="group hover:cursor-pointer flex justify-between items-center py-2 transition-colors"
        >
          <h2 class="text-base font-medium text-heading group-hover:text-cappuccino-dark">
            {blog.frontmatter.title}
          </h2>
          <time
            datetime={blog.frontmatter.date}
            class="text-sm text-cappuccino ml-4 flex-shrink-0"
          >
            {formatDate(blog.frontmatter.date)}
          </time>
        </a>
      ))
    }
  </div>
</div>
